// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  RECEPTIONIST
  VET
}

enum Status {
  ACTIVE
  INACTIVE
}

enum Sex {
  MALE
  FEMALE
}

enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELED
}

enum PaymentMethod {
  PIX
  CREDIT_CARD
  DEBIT_CARD
  CASH
}

enum PaymentStatus {
  PENDING
  PAID
  CANCELED
}

model User {
  id                          String    @id @default(uuid())
  name                        String
  email                       String    @unique
  password                    String
  status                      Status    @default(ACTIVE)
  createdAt                   DateTime  @default(now()) @map("created_at")
  updatedAt                   DateTime  @updatedAt @map("updated_at")
  role                        Role      @default(RECEPTIONIST)
  passwordResetTokenHash      String?   @unique @map("password_reset_token_hash")
  passwordResetTokenExpiresAt DateTime? @map("password_reset_token_expires_at")

  veterinarian Veterinarian?

  @@map("users")
}

model Veterinarian {
  id        String   @id @default(uuid())
  crmv      String   @unique
  specialty String?
  phone     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  userId         String          @unique @map("user_id")
  user           User            @relation(fields: [userId], references: [id])
  appointments   Appointment[]
  medicalRecords MedicalRecord[]
  vaccinations   Vaccination[]
  prescriptions  Prescription[]

  @@map("veterinarians")
}

model Guardian {
  id        String   @id @default(uuid())
  name      String
  cpf       String   @unique
  email     String?
  phone     String
  status    Status   @default(ACTIVE)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  pets         Pet[]
  appointments Appointment[]

  @@index([name])
  @@map("guardians")
}

model Pet {
  id        String    @id @default(uuid())
  name      String
  species   String
  sex       Sex
  birthDate DateTime? @map("birth_date")
  breed     String?
  status    Status    @default(ACTIVE)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  guardianId     String          @map("guardian_id")
  guardian       Guardian        @relation(fields: [guardianId], references: [id])
  appointments   Appointment[]
  medicalRecords MedicalRecord[]
  vaccinations   Vaccination[]
  prescriptions  Prescription[]

  @@index([guardianId])
  @@map("pets")
}

model Appointment {
  id                 String            @id @default(uuid())
  scheduledAt        DateTime          @map("scheduled_at")
  status             AppointmentStatus @default(SCHEDULED)
  reason             String?
  cancellationReason String?           @map("cancellation_reason")
  canceledAt         DateTime?         @map("canceled_at")

  petId          String       @map("pet_id")
  pet            Pet          @relation(fields: [petId], references: [id])
  guardianId     String       @map("guardian_id")
  guardian       Guardian     @relation(fields: [guardianId], references: [id])
  veterinarianId String       @map("veterinarian_id")
  veterinarian   Veterinarian @relation(fields: [veterinarianId], references: [id])

  medicalRecord MedicalRecord?
  payment       Payment?
  vaccinations  Vaccination[]
  prescriptions Prescription[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([veterinarianId, scheduledAt])
  @@index([petId])
  @@map("appointments")
}

model MedicalRecord {
  id            String  @id @default(uuid())
  diagnosis     String
  observations  String?
  procedures    String?
  prescriptions String?

  appointmentId  String       @unique @map("appointment_id")
  appointment    Appointment  @relation(fields: [appointmentId], references: [id])
  petId          String       @map("pet_id")
  pet            Pet          @relation(fields: [petId], references: [id])
  veterinarianId String       @map("veterinarian_id")
  veterinarian   Veterinarian @relation(fields: [veterinarianId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([petId, createdAt])
  @@map("medical_records")
}

model Payment {
  id          String        @id @default(uuid())
  amount      Decimal       @db.Decimal(10, 2)
  method      PaymentMethod
  status      PaymentStatus @default(PENDING)
  description String?
  paidAt      DateTime?     @map("paid_at")

  appointmentId String      @unique @map("appointment_id")
  appointment   Appointment @relation(fields: [appointmentId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@map("payments")
}

model Vaccination {
  id          String    @id @default(uuid())
  vaccineName String    @map("vaccine_name")
  batch       String?
  appliedAt   DateTime  @default(now()) @map("applied_at")
  nextDoseAt  DateTime? @map("next_dose_at")
  notes       String?

  petId          String       @map("pet_id")
  pet            Pet          @relation(fields: [petId], references: [id])
  veterinarianId String       @map("veterinarian_id")
  veterinarian   Veterinarian @relation(fields: [veterinarianId], references: [id])
  appointmentId  String?      @map("appointment_id")
  appointment    Appointment? @relation(fields: [appointmentId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([petId, appliedAt])
  @@map("vaccinations")
}

model Prescription {
  id           String    @id @default(uuid())
  medications  String
  instructions String?
  validUntil   DateTime? @map("valid_until")

  appointmentId  String       @map("appointment_id")
  appointment    Appointment  @relation(fields: [appointmentId], references: [id])
  petId          String       @map("pet_id")
  pet            Pet          @relation(fields: [petId], references: [id])
  veterinarianId String       @map("veterinarian_id")
  veterinarian   Veterinarian @relation(fields: [veterinarianId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([appointmentId])
  @@index([petId, createdAt])
  @@map("prescriptions")
}
