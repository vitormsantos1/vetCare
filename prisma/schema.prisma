// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  RECEPTIONIST
  VET
}

enum Status {
  ACTIVE
  INACTIVE
}

enum Sex {
  MALE
  FEMALE
}

enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELED
}

model User {
  id                          String    @id @default(uuid())
  name                        String
  email                       String    @unique
  password                    String
  status                      Status    @default(ACTIVE)
  createdAt                   DateTime  @default(now()) @map("created_at")
  updatedAt                   DateTime  @updatedAt @map("updated_at")
  role                        Role      @default(RECEPTIONIST)
  passwordResetTokenHash      String?   @unique @map("password_reset_token_hash")
  passwordResetTokenExpiresAt DateTime? @map("password_reset_token_expires_at")

  veterinarian Veterinarian?

  @@map("users")
}

model Veterinarian {
  id        String   @id @default(uuid())
  crmv      String   @unique
  specialty String?
  phone     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  userId         String          @unique @map("user_id")
  user           User            @relation(fields: [userId], references: [id])
  appointments   Appointment[]
  medicalRecords MedicalRecord[]

  @@map("veterinarians")
}

model Guardian {
  id        String   @id @default(uuid())
  name      String
  cpf       String   @unique
  email     String?
  phone     String
  status    Status   @default(ACTIVE)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  pets         Pet[]
  appointments Appointment[]

  @@index([name])
  @@map("guardians")
}

model Pet {
  id        String    @id @default(uuid())
  name      String
  species   String
  sex       Sex
  birthDate DateTime? @map("birth_date")
  breed     String?
  status    Status    @default(ACTIVE)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  guardianId     String          @map("guardian_id")
  guardian       Guardian        @relation(fields: [guardianId], references: [id])
  appointments   Appointment[]
  medicalRecords MedicalRecord[]

  @@index([guardianId])
  @@map("pets")
}

model Appointment {
  id                 String            @id @default(uuid())
  scheduledAt        DateTime          @map("scheduled_at")
  status             AppointmentStatus @default(SCHEDULED)
  reason             String?
  cancellationReason String?           @map("cancellation_reason")
  canceledAt         DateTime?         @map("canceled_at")

  petId          String       @map("pet_id")
  pet            Pet          @relation(fields: [petId], references: [id])
  guardianId     String       @map("guardian_id")
  guardian       Guardian     @relation(fields: [guardianId], references: [id])
  veterinarianId String       @map("veterinarian_id")
  veterinarian   Veterinarian @relation(fields: [veterinarianId], references: [id])

  medicalRecord MedicalRecord?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([veterinarianId, scheduledAt])
  @@index([petId])
  @@map("appointments")
}

model MedicalRecord {
  id            String  @id @default(uuid())
  diagnosis     String
  observations  String?
  procedures    String?
  prescriptions String?

  appointmentId  String       @unique @map("appointment_id")
  appointment    Appointment  @relation(fields: [appointmentId], references: [id])
  petId          String       @map("pet_id")
  pet            Pet          @relation(fields: [petId], references: [id])
  veterinarianId String       @map("veterinarian_id")
  veterinarian   Veterinarian @relation(fields: [veterinarianId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([petId, createdAt])
  @@map("medical_records")
}
